theme(legend.position = "top")
p
p <- ggplot(shots, aes(x = distance, y = angle, colour = shot_type, fill = shot_type)) +
geom_point(alpha = 0.4, size = 1.5) +
geom_smooth(method = "lm", formula = y ~ x, alpha = 0.2) +
facet_wrap(~ shot_type) +
labs(
title = "Relationship between distance and angle",
x = "Distance (m)",
y = "Angle (°)"
) +
theme_minimal() +
theme(legend.position = "none")
p

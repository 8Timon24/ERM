p <- ggplot(shots, aes(x = distance, y = angle, colour = shot_type, fill = shot_type)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.15) +
labs(title = "Relationship between distance and angle", x = "distance", y = "angle") +
theme_minimal() +

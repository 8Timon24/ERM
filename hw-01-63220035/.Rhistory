plot <- ggplot(grouped, aes(x = distance, y = angle, fill = grp)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.15) +
labs(title = "Relationship between distance and angle", x = "distance", y = "angle") +
theme_minimal() +
theme(legend.position = "none")
p <- ggplot(grouped, aes(x = distance, y = angle, fill = grp)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.15) +
labs(title = "Relationship between distance and angle", x = "distance", y = "angle") +
theme_minimal() +
theme(legend.position = "none")
plot(p)
p <- ggplot(grouped, aes(x = mean_distance, y = mean_angle, fill = grp)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.15) +
labs(title = "Relationship between distance and angle", x = "distance", y = "angle") +
theme_minimal() +
theme(legend.position = "none")
plot(p)

library(patchwork)
library(tidyverse)
library(here)
library(boot)
library(patchwork)
#Loading data
data(mammals, package = "MASS")
plot(brain ~ body, data = mammals)
model <- lm(brain ~ body, data = mammals)
summarise(mammals)
#Loading data
data(mammals, package = "MASS")
plot(brain ~ body, data = mammals)
model <- lm(brain ~ body, data = mammals)
model <- lm(log(brain) ~ log(body), data = mammals)
plot(log(brain) ~ log(body), data = mammals)
model <- lm(log(brain) ~ log(body), data = mammals)
plot(log(brain) ~ log(body), data = mammals)
#Loading data
data(mammals, package = "MASS")
# 1) začetni model
plot(brain ~ body, data = mammals)
model0 <- lm(brain ~ body, data = mammals)
print(summary(model0))
# 2) diagnostika
plot(model0, which = 1)
plot(model0, which = 2)
plot(model0, which = 5)   # preberi imena označenih točk
# 3) odstranitev ene točke (ime vpiši glede na graf 5)
removed <- c("Brachiosaurus")   # <- zamenjaj po pogledu grafa
dat1 <- mammals[!(rownames(mammals) %in% removed), ]
model1 <- lm(brain ~ body, data = dat1)
print(summary(model1))
plot(model1, which = 5)
# 4) če je še vedno kakšna točka čez Cookovo črto, ponovi:
# removed <- c(removed, "ime_druge_točke")
# dat1 <- mammals[!(rownames(mammals) %in% removed), ]
# model1 <- lm(brain ~ body, data = dat1)
# plot(model1, which = 5)
# 5) primerjava
print(rbind(before = coef(model0), after = coef(model1)))
cat("R2 before:", round(summary(model0)$r.squared, 4), "\n")
cat("R2 after: ", round(summary(model1)$r.squared, 4), "\n")
plot(brain ~ body, data = mammals)
abline(model0, col = "red", lty = 2)
abline(model1, col = "blue")
points(mammals[removed, ], col = "orange", pch = 19)

#Loading data
data(mammals, package = "MASS")
# 1) začetni model
plot(brain ~ body, data = mammals)
model0 <- lm(brain ~ body, data = mammals)
print(summary(model0))
# 2) diagnostika
plot(model0, which = 1)
plot(model0, which = 2)
plot(model0, which = 5)   # preberi imena označenih točk
# 3) odstranitev ene točke (ime vpiši glede na graf 5)
# odstranimo prvo točko
removed <- c("African elephant")
dat1 <- mammals[!(rownames(mammals) %in% removed), ]
model1 <- lm(brain ~ body, data = dat1)
print(summary(model1))
plot(model1, which = 5)
# odstranimo drugo točko
removed <- c("African elephant", "Asian elephant")
dat2 <- mammals[!(rownames(mammals) %in% removed), ]
model2 <- lm(brain ~ body, data = dat2)
print(summary(model2))
plot(model2, which = 5)
removed <- c("African elephant", "Asian elephant", "Human")
dat3 <- mammals[!(rownames(mammals) %in% removed), ]
model3 <- lm(brain ~ body, data = dat3)
print(summary(model3))
plot(model3, which = 5)
removed <- c("African elephant", "Asian elephant", "Human", "Cow")
dat4 <- mammals[!(rownames(mammals) %in% removed), ]
model4 <- lm(brain ~ body, data = dat4)
print(summary(model4))
plot(model4, which = 5)
# 1) FINAL FIT
model_final <- lm(brain ~ body, data = dat4)
print(summary(model_final))
# 2) DIAGNOSTICS (one figure, fits on one page)
par(mfrow = c(2, 2))
plot(model_final, which = 1)                      # linearity + homoskedasticity
plot(model_final, which = 2)                      # normality (QQ)
plot(dat4$body, residuals(model_final),           # homoskedasticity vs input
xlab = "body", ylab = "residuals")
abline(h = 0, lty = 2)
acf(residuals(model_final), main = "ACF of residuals")  # independence
par(mfrow = c(1, 1))
# 3) UNCERTAINTY: OLS -----------------------------------------------------------
model_summary <- summary(model_final)$coefficients
model_ci95 <- confint(model_final)
# 4) UNCERTAINTY: BOOTSTRAP (pairs, R = 1000) -----------------------------------
boot_lm <- function(data, indices) {
boot_data <- data[indices, ]
fit <- lm(brain ~ body, data = boot_data)
c(coef(fit), summary(fit)$sigma)
}
set.seed(1)
boot_results <- boot(data = dat4, statistic = boot_lm, R = 1000)
boot_se <- apply(boot_results$t, 2, sd)
boot_ci95 <- apply(boot_results$t, 2, quantile, probs = c(0.025, 0.975))
comparison <- data.frame(
Parameter = c("Intercept", "body", "sigma"),
Estimate = c(coef(model_final), summary(model_final)$sigma),
Bootstrap_SE = boot_se,
OLS_SE = c(model_summary[, "Std. Error"], NA),
Bootstrap_CI_Lower = boot_ci95[1, ],
Bootstrap_CI_Upper = boot_ci95[2, ],
OLS_CI_Lower = c(model_ci95[, 1], NA),
OLS_CI_Upper = c(model_ci95[, 2], NA)
)
print(comparison)

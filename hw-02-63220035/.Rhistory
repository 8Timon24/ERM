# 1) povzetek za Kitajsko: povprečje proti mediani, in v domači valuti
cafe |>
filter(country == "China") |>
summarise(n = n(),
mean_gbp = mean(price_gbp),
median_gbp = median(price_gbp),
max_gbp = max(price_gbp),
mean_cny = mean(price),
mean_wage_cny = mean(hourly_wage))
# 2) ali je tečaj (price / price_gbp) znotraj države konstanten?
cafe |>
mutate(rate = price / price_gbp) |>
group_by(country) |>
summarise(rate_min = min(rate), rate_max = max(rate)) |>
mutate(spread = rate_max - rate_min) |>
arrange(desc(spread))
# 3) mesta s Kitajske
cafe |> filter(country == "China") |> count(city, sort = TRUE)
